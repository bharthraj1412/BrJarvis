    classDef external fill:#ffe8e8,stroke:#c53030,color:#641b1b;
    class CLI,WEB,DESKTOP,CAREER,REMOTE surface;
    class RUNTIME,ROUTER,ORCH runtime;
    class TOOLS,POLICY,VERIFY control;
    class MEMORY,TASKS,EVENTS,ARTIFACTS data;
    class PROVIDERS,OS external;
