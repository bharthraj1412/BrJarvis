flowchart LR
    USER[User]
    CLI[CLI / start.py]
    WEB[FastAPI + packaged PWA]
    DESKTOP[Qt voice UI + floating widget]
    CAREER[Career OS]
    REMOTE[Mobile / Telegram adapters]

    RUNTIME[AssistantRuntime\ncore bootstrap singleton]
    ROUTER[AgentRouter\nprovider selection]
    ORCH[JarvisOrchestrator\nReAct + tool loop]
    TOOLS[Tool Registry\nschemas + connector tools]
    POLICY[Security Policy\ncapabilities + approvals]
    VERIFY[Verification + evidence]
    MEMORY[Unified Memory\nSQLite + vector + working memory]
    TASKS[Task State + Queue\nSQLite + checkpoints]
    EVENTS[EventBus + JSONL store]
    ARTIFACTS[Contained workspace + artifacts]
    PROVIDERS[Gemini / OpenAI-compatible\nAnthropic / Mistral / Ollama]
    OS[Local OS\nfiles, browser, audio, desktop]

    USER --> CLI
    USER --> WEB
    USER --> DESKTOP
    USER --> CAREER
    USER --> REMOTE
    CLI --> RUNTIME
    WEB --> RUNTIME
    DESKTOP --> RUNTIME
    CAREER --> RUNTIME
    REMOTE --> RUNTIME
    RUNTIME --> ROUTER
    RUNTIME --> ORCH
    RUNTIME --> EVENTS
    ORCH --> PROVIDERS
    ORCH --> TOOLS
    TOOLS --> POLICY
    POLICY -->|approval when required| TOOLS
    TOOLS --> OS
    TOOLS --> ARTIFACTS
    ORCH --> MEMORY
    ORCH --> TASKS
    TASKS --> EVENTS
    TOOLS --> VERIFY
    VERIFY --> TASKS
    VERIFY --> EVENTS
    MEMORY --> EVENTS

